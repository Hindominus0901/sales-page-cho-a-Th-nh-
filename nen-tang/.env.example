# Mau cho file .env khi chay o MAY.
#   cp .env.example .env    roi dien gia tri that
#
# .env duoc dung cho hai viec:
#   1. wrangler dev doc lam bien moi truong cua Worker
#   2. apps/funnel/build.mjs doc de dung 5 trang ban hang
#
# TREN CLOUDFLARE THAT (khong dung file nay):
#   - gia tri cong khai -> muc "vars" trong wrangler.jsonc
#   - gia tri bi mat    -> npx wrangler secret put TEN_BIEN
#
# ---------------------------------------------------------------------------
# DIEN O DAU? Hai loai gia tri, hai cho khac nhau:
#
#   CONG KHAI (in thang tren trang: so tai khoan, Zalo, gia, ten, mau, video)
#     -> brand/brand.json, roi `npm run brand:apply`. VAO GIT.
#
#   BI MAT (khoa API, mat khau, khoa ky phien)
#     -> file .env nay khi chay o may;
#        `npx wrangler secret put TEN_BIEN` khi chay that.
#        .env KHONG vao git - xem .gitignore.
# ---------------------------------------------------------------------------

# ---- Quan tri (/admin) ----
ADMIN_USER=admin
# Sinh bang: npm run hash-password "mat khau cua ban"
# KHONG bao gio dat mat khau de nguyen o day. Chua dat bien nay = trang quan tri dong.
ADMIN_PASSWORD_HASH=
# Token cho script/CI (bo smoke test dung). De trong = tat han.
ADMIN_SERVICE_TOKEN=
# Khoa ky cookie phien. De trong thi suy ra tu ban bam mat khau
# (khi do doi mat khau se lam moi phien dang mo bi vo hieu).
SESSION_SECRET=
ADMIN_SESSION_HOURS=12

# ---- Webhook ngan hang (SePay / Casso) ----
# De trong = TU CHOI moi webhook. Dat trung voi cau hinh ben SePay.
BANK_WEBHOOK_SECRET=
# URL nhan thong bao khi co lead/don moi (Slack, n8n, Zapier, Google Apps Script...)
NOTIFY_WEBHOOK_URL=

# ---- San pham ----

# ---- Tai khoan nhan tien (hien tren ma VietQR) ----

# ---- Zalo ----
# Link nhom Zalo hien tren trang xac nhan dang ky

# ---- Video ----
# De trong = dung video co san trong ban thiet ke. Dat ID de doi video chinh
# ma khong phai sua file thiet ke.
HERO_VIDEO_YOUTUBE_ID=

# ---- Affiliate ----
# Ty le hoa hong (%) nam o brand.json -> product.affiliateRate.
# So ngay giu cookie ghi nhan nguoi gioi thieu
AFFILIATE_COOKIE_DAYS=60
# Tu dong cap link gioi thieu cho moi nguoi dang ky
AFFILIATE_AUTO_ENROLL=true
# Qua bao nhieu luot tu cung mot IP thi chuyen sang cho admin duyet (0 = tat)
AFFILIATE_MAX_PER_IP=3

# ---- Gioi han so lan goi ----
RATE_LEAD_PER_HOUR=10
RATE_ORDER_PER_HOUR=20
RATE_TRACK_PER_MINUTE=120
MAX_BODY_BYTES=65536

# ---- Chi bo test dung (Worker khong bao gio doc bien nay) ----
# Mat khau goc ung voi ADMIN_PASSWORD_HASH o tren, de smoke test dang nhap thu.
SMOKE_ADMIN_PASSWORD=

# ---- Dang nhap (giai doan 2) ----
# Pepper cho ma OTP. Ma chi co 6 chu so nen neu chi bam tran thi ke doc duoc
# database do het mot trieu kha nang trong tich tac; pepper nam ngoai database
# khien viec do do vo nghia.
OTP_PEPPER=
# Resend: de trong thi ma OTP in ra log thay vi gui mail (chi tien khi chay o may)
RESEND_API_KEY=
# Google OAuth. Duong dan chuyen ve can khai bao ben Google Cloud Console:
#   https://<ten-mien>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Chon tai khoan Cloudflare de deploy ----
# Mot nguoi co the la thanh vien cua NHIEU tai khoan Cloudflare (tai khoan
# rieng cua minh, va tai khoan cua tung khach hang). Bien nay quyet dinh
# wrangler deploy vao tai khoan NAO - dat sai la day len nham cho.
#
# Lay o: Cloudflare dashboard -> chon dung tai khoan -> Account ID o cot phai.
# Cach lam dung: KHACH tao tai khoan (de du lieu va the thanh toan dung ten ho),
# roi Manage Account -> Members -> Invite email cua ban voi quyen
# "Super Administrator". Workers va D1 KHONG chuyen duoc giua hai tai khoan, nen
# dung xay o tai khoan minh roi tinh ban giao sau.
CLOUDFLARE_ACCOUNT_ID=
# Chi can khi chay tu may chu tu dong (CI). Nguoi that thi dung `wrangler login`.
CLOUDFLARE_API_TOKEN=

# LUU Y: nhung bien mang gia tri thuong hieu (san pham, gia, ngan hang, Zalo,
# video, pixel) KHONG dien o day nua. Chung duoc SINH RA tu brand/brand.json:
#   npm run brand:apply
# File nay chi con giu bi mat va cau hinh rieng cua tung may.

# ---- Bien truoc day khong duoc ghi o dau ----
# Ma tim ra chung bang cach doc worker/src, khong phai bang cach doc file nay -
# tuc la ai cam repo ve deu phai doan. Liet ke ra day de het doan.

# Ten mien cua khu vuc thanh vien. worker/src/index.js doc de tach webapp khoi
# trang ban hang. De trong = ca hai ten mien cung tra trang ban hang.
# Kit (ConvertKit): gan the va chay chuoi email tu dong sau khi dien form.
KIT_API_KEY=
# Cho phep goi Kit ca khi chay o may (mac dinh: chi goi tren ban that).
KIT_ALLOW_DEV=
# Cac ten mien duoc phep goi API tu trinh duyet. De trong = chi chinh minh.
CORS_ORIGINS=
# Model AI cham bai. De trong = dung model mac dinh trong worker/src/functions/ai.js
AI_MODEL=
# Cuoc dua diem thuong hien thi tren bang xep hang.
CONTEST_TITLE=
CONTEST_PRIZE_POOL=
CONTEST_TOP=
CONTEST_START=
CONTEST_END=
# Ghi de bac phan thuong va cau chu chia se (JSON). De trong = dung ban trong ma.
REWARD_TIERS_JSON=
SHARE_MESSAGES_JSON=
# Video huong dan o trang cam on (/xac-nhan), khac video ban hang o trang chu.

# ---------------------------------------------------------------------------
# KHONG dat o day: PRODUCT_*, PRICE_*, BANK_*, ZALO_*, MAIL_FROM, APP_HOST,
# CONFIRM_VIDEO_*, AFFILIATE_RATE.
#
# Chung duoc SINH RA vao wrangler.jsonc tu brand/brand.json. `wrangler dev` doc
# .env DE LEN wrangler.jsonc, nen mot dong rong o day xoa gia tri that - va
# trang bao "Cong thanh toan chua duoc cau hinh" ma khong noi vi sao. Muon doi
# thi sua brand/brand.json roi chay `npm run brand:apply`.
# ---------------------------------------------------------------------------

# Chay o may: de "development" thi sendMail() in ma OTP ra console thay vi doi
# RESEND_API_KEY, nho vay `npm test` xanh duoc ma khong can tai khoan email that.
# Ban deploy KHONG doc file nay (wrangler.jsonc dat ENVIRONMENT=production).
ENVIRONMENT=development
